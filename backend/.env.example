# Supabase + NVIDIA settings for deploying the backend.
# Copy this file to .env or use it as a reference for your hosting provider's environment settings.
PORT=4000
FRONTEND_URL=

# Get this exact URI from Supabase Dashboard > Connect > Session pooler.
# This app uses direct PostgreSQL from the backend, so SUPABASE_URL and anon/service-role API keys are not required.
# Replace every placeholder; URL-encode special characters in the database password.
DATABASE_URL=
PGSSL=true
PGPOOL_MAX=5

AUTH_ENABLED=true
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

RETRIEVAL_MIN_SIMILARITY=0.3
RETRIEVAL_MAX_RESULTS=4
RETRIEVAL_HISTORY_LIMIT=8
AI_TIMEOUT_MS=20000
ALLOW_DEV_FALLBACK=false
