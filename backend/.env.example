PORT=4000
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database — choose ONE style.
#
# Style A (recommended for LOCAL dev): discrete variables.
# No URL-encoding needed, so passwords with @ : / # etc. work as-is.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_local_postgres_password
PGDATABASE=cx_reply_assistant
# PGSSL=false

# Style B (recommended for HOSTED Postgres like Supabase): one URL.
# If you use this, leave the PG* vars above blank. URL-encode special chars.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ---------------------------------------------------------------------------

# Demo auth. AUTH_ENABLED=false opens the API (no login). Override AUTH_SECRET in prod.
AUTH_ENABLED=true
AUTH_SECRET=dev-insecure-demo-secret-change-me

# AI / LLM (OpenRouter). Leave blank to run the app without live AI generation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Embeddings (OpenAI-compatible, 1536-dim e.g. text-embedding-3-small).
# Can reuse the OpenRouter/DeepInfra key depending on provider.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
